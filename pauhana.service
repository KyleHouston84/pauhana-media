[Unit]
Description=Pau Hana Media - Tiki Bar Event Orchestration
After=network.target

[Service]
Type=simple
User=kyle
WorkingDirectory=/home/kyle/pauhana-media
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
# PrivateTmp=true  # Disabled to allow access to mpv socket in /tmp

[Install]
WantedBy=multi-user.target
