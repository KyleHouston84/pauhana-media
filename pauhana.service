[Unit]
Description=Pau Hana Media - Tiki Bar Event Orchestration
After=network.target

[Service]
Type=simple
User=kyle
WorkingDirectory=/home/kyle/pauhana-media
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# PrivateTmp=true  # Disabled to allow access to mpv socket in /tmp
# NoNewPrivileges=true  # Disabled to allow sudo for display control (pauhana-display sudoers rule)

[Install]
WantedBy=multi-user.target
